# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
#   cp .env.example .env
#
# Every variable is listed here, including the optional ones. Anything marked
# OPTIONAL can be left blank or deleted entirely; the default in brackets is
# what the server falls back to.
#
# The endpoints are hard-coded to Adyen TEST
# (terminal-api-test.adyen.com / management-test.adyen.com), so use test
# credentials.


# ============================================================================
# Adyen credentials — REQUIRED
# ============================================================================

# REQUIRED. Sent as the `x-API-key` header on every Adyen call: the Terminal API
# (payments, refunds, aborts, printing, card acquisition) and, if you use Tap to
# Pay, the Management API. Generate it in the Customer Area under
# Developers > API credentials. Keep it secret — never commit the filled-in .env.
ADYEN_API_KEY=

# REQUIRED. Your merchant account name, e.g. "YourCompanyECOM". Used as the
# merchantAccount in connectedTerminals lookups and in the Management API paths
# for Tap to Pay boarding, revoking and listing app instances. Tap to Pay
# endpoints return HTTP 500 if this is missing.
ADYEN_MERCHANT_ACCOUNT=


# ============================================================================
# Login — REQUIRED
# ============================================================================

# REQUIRED. Single shared access code for the login page; there are no
# usernames. There is deliberately no fallback: if this is blank the server
# refuses every login with HTTP 503 rather than silently accepting a default.
ACCESS_CODE=

# OPTIONAL [pos-web-app-secret-change-me]. HMAC key used to sign the session
# cookie. The default is public in this repo, so anyone could forge a session —
# set a long random value in any deployment that is not local. It must also stay
# stable across restarts and across instances, otherwise everyone is logged out
# on every deploy. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# ============================================================================
# Terminals and payments
# ============================================================================

# OPTIONAL [empty]. Comma-separated POI IDs to preload into the terminal list at
# startup, e.g. "V400m-123456789,S1F2-987654321". The first one becomes the
# active terminal. Terminals can also be added in the UI at runtime, but those
# are only kept in memory and are lost on restart, so seeding them here is the
# way to make them survive a redeploy. At most 5 terminals are kept.
ADYEN_TERMINAL_POIID=

# OPTIONAL [POSWebApp]. The SaleID in the Terminal API message header, i.e. the
# name identifying this cash register to Adyen. Only worth changing if you run
# several tills against the same merchant account.
ADYEN_SALE_ID=

# OPTIONAL [EUR]. Default currency for new payments, as a three-letter ISO code.
# EUR is only the fallback compiled into the code for when this is unset; the
# deployed instance of this project runs on SGD, so set it explicitly rather than
# relying on the default. The frontend can override it per transaction.
CURRENCY=

# OPTIONAL [130000]. Deadline in milliseconds for a single Terminal API call.
# It exists so a request against an unreachable terminal cannot hang forever, so
# keep it comfortably above the time a cardholder may spend at the terminal.
# Internal lookups that never wait on the device use a fixed short timeout.
ADYEN_REQUEST_TIMEOUT_MS=

# OPTIONAL [10000]. Deadline in milliseconds for Terminal API calls that nobody is
# standing at the terminal for: reversal refunds, receipt prints and status polls.
# Much shorter than the interactive deadline above, because there is no cardholder
# to wait for and a spinner that hangs for two minutes is worse than an error.
ADYEN_UNATTENDED_TIMEOUT_MS=


# ============================================================================
# Receipt printing
# ============================================================================

# OPTIONAL [S1F2,S1F4,V400,V240]. Comma-separated terminal model prefixes that
# have a built-in receipt printer. A POI ID looks like "V400m-346536527", so the
# part before the first dash is matched against this list to decide whether an
# order gets a Reprint button. Add your model here if its reprint button is
# missing.
PRINTER_TERMINAL_MODELS=

# OPTIONAL [32]. Character width of the receipt, used to pad label/value rows so
# amounts line up on the right. 32 suits the usual 384 px print head; widen it
# only for a wider printer.
RECEIPT_PRINT_WIDTH=

# OPTIONAL [https://adyen.com.cn]. Default content of the QR code printed at the
# bottom of the receipt. Any URL or text works. This is only the default — it can
# be changed at runtime in the Receipt dialog, which persists to
# assets/receipt-settings.json, and the Reset button there returns to this value.
RECEIPT_QR_URL=


# ============================================================================
# Tap to Pay (Android Payments app)
# ============================================================================
# Only needed if you use Tap to Pay. Leave the whole block blank for a
# terminal-only setup. The Nexo key must be the same one configured on the
# Payments app in the Customer Area, otherwise boarding and payments fail to
# decrypt.

# REQUIRED for Tap to Pay. Nexo shared key identifier.
ADYEN_NEXO_KEY_IDENTIFIER=

# REQUIRED for Tap to Pay. Nexo shared key passphrase. Secret.
ADYEN_NEXO_KEY_PASSPHRASE=

# OPTIONAL [1]. Nexo shared key version. Only change it if the key you were
# given has a different version number.
ADYEN_NEXO_KEY_VERSION=

# OPTIONAL [ST32CQ6223229X5PBQCM9BCWF]. Default store ID used when boarding a
# device and when listing app instances. The built-in default is a test store, so
# set your own. It can also be overridden per session in the Tap to Pay dialog,
# which remembers it in the browser's localStorage.
ADYEN_PAYMENTS_APP_STORE_ID=


# ============================================================================
# Order storage
# ============================================================================
# Orders hold the PSP and tender references a payment is reconciled by, so they
# are the one thing here worth keeping. Everything else the app stores (logo, QR
# content, members) lives in the application directory, which a deploy replaces.

# OPTIONAL [none]. Connection string of the Azure Storage account orders are
# written to. Set this on Azure: without it orders fall back to a local JSON file
# under assets/, which every redeploy wipes. Copy it from the storage account
# under Security + networking > Access keys. Secret.
AZURE_STORAGE_CONNECTION_STRING=

# OPTIONAL [orders]. Table the orders are stored in. Created on first use, so the
# name only has to be a valid table name; no setup is needed in the portal.
AZURE_ORDERS_TABLE=

# OPTIONAL [200]. How many of the most recent orders are read back into memory at
# startup. Storage keeps every order regardless; this only bounds the list the app
# shows and holds in RAM.
ORDER_HISTORY_LIMIT=

# OPTIONAL [assets/orders.json]. Where orders go when no connection string is set.
# Only useful for local development.
ORDER_STORE_FILE=


# ============================================================================
# Server
# ============================================================================

# OPTIONAL [3000]. Port to listen on. On Azure App Service the platform injects
# this, so leave it unset there.
PORT=

# OPTIONAL [certs/localhost-key.pem and certs/localhost-cert.pem]. Paths to a TLS
# key and certificate. If both files are readable the server serves HTTPS,
# otherwise it falls back to plain HTTP. This is for local development only —
# Tap to Pay App Links and the camera require a secure context. Generate the
# default pair with `npm run certs`. On Azure, HTTPS is terminated at the
# platform's front end and these files are absent, which is the intended
# behaviour.
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=
