# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
#   cp .env.example .env
#
# Endpoints are hard-coded to Adyen TEST, so use test credentials.
# Optional variables show their default in [brackets]; leave one blank to take it.


# ============================================================================
# REQUIRED
# ============================================================================

# Sent as `x-API-key` on every Adyen call. Customer Area > Developers > API
# credentials.
ADYEN_API_KEY=

# e.g. "YourCompanyECOM". Tap to Pay endpoints return HTTP 500 without it.
ADYEN_MERCHANT_ACCOUNT=

# Single shared login code — there are no usernames. No fallback on purpose:
# while this is blank every login is refused with HTTP 503.
ACCESS_CODE=

# Signs the session cookie. It does have a fallback, but that fallback is
# published in this repo, so anything other than local development has to set
# its own or sessions can be forged. Keep it stable across restarts and
# instances, otherwise every deploy logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# ---------------------------------------------------------------------------
# Required only if you use Tap to Pay
# ---------------------------------------------------------------------------
# Must be the same Nexo key configured on the Payments app in the Customer Area,
# or boarding and payments fail to decrypt. Leave both blank for a
# terminal-only setup.

ADYEN_NEXO_KEY_IDENTIFIER=

# Secret.
ADYEN_NEXO_KEY_PASSPHRASE=


# ============================================================================
# OPTIONAL — every one of these has a working default
# ============================================================================

# ---- Terminals and payments ----

# [empty] Comma-separated POI IDs to preload, e.g.
# "V400m-123456789,S1F2-987654321"; the first becomes active. Terminals added in
# the UI live in memory only, so seed them here to survive a restart.
ADYEN_TERMINAL_POIID=

# [POSWebApp] SaleID in the Terminal API header. Only worth changing if several
# tills share one merchant account.
ADYEN_SALE_ID=

# [EUR] Three-letter ISO code. EUR is only the compiled-in fallback — the
# deployed instance of this project runs on SGD, so set this explicitly.
CURRENCY=

# [130000] Deadline in ms for one Terminal API call, so a request against an
# unreachable terminal cannot hang forever. Keep it comfortably above the time a
# cardholder may spend at the terminal.
ADYEN_REQUEST_TIMEOUT_MS=

# [10000] Deadline in ms for calls nobody is standing at the terminal for:
# reversal refunds, receipt prints, status polls.
ADYEN_UNATTENDED_TIMEOUT_MS=


# ---- Receipt printing ----

# [S1F2,S1F4,V400,V240] Model prefixes that have a built-in printer. The part of
# a POI ID before the first dash is matched against this list to decide whether
# an order gets a Reprint button.
PRINTER_TERMINAL_MODELS=

# [32] Receipt width in characters, used to right-align amounts. 32 suits the
# usual 384 px print head.
RECEIPT_PRINT_WIDTH=

# [https://adyen.com.cn] Default contents of the receipt QR code. Changeable at
# runtime in the Receipt dialog, and this is the value Reset there returns to.
RECEIPT_QR_URL=


# ---- Tap to Pay ----

# [1] Nexo shared key version. Only change it if the key you were given has a
# different version number.
ADYEN_NEXO_KEY_VERSION=

# [ST32CQ6223229X5PBQCM9BCWF] Default store for boarding and for listing app
# instances. The built-in value is a test store, so set your own. Overridable
# per session in the Tap to Pay dialog.
ADYEN_PAYMENTS_APP_STORE_ID=


# ---- Orders ----

# [200] How many of the most recent orders are read back into memory at startup.
# Storage keeps every order regardless; this only bounds what the app holds.
ORDER_HISTORY_LIMIT=

# [assets/orders.json] Where orders go when no Azure connection string is set.
# Local development only.
ORDER_STORE_FILE=


# ---- Local server ----

# [3000] Azure App Service injects this, so leave it unset there.
PORT=

# [certs/localhost-key.pem, certs/localhost-cert.pem] TLS pair for local HTTPS,
# which Tap to Pay App Links and the camera both require. Falls back to plain
# HTTP if either file is unreadable. Generate the default pair with
# `npm run certs`. Absent on Azure, where TLS terminates at the platform front
# end.
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=


# ---- Cancelling a payment ----
# An AbortRequest only confirms the terminal accepted the message, never that the
# payment stopped, and one pressed too early is discarded silently while the sale
# carries on. The cancel button is withheld for the first seconds of a sale for
# that reason, which is in the browser and not configurable here.

# [10000] How long a cancel waits for its payment to actually be sent before
# aborting anyway. Reached only when the two never met — a cancel that outlived a
# restart, or one that landed on a different instance from its payment.
ABORT_DISPATCH_WAIT_MS=


# ============================================================================
# AZURE APP SERVICE ONLY
# ============================================================================
# Skip this block entirely for local development.

# Storage account orders are written to. Without it orders fall back to a local
# JSON file that every redeploy wipes — and orders carry the PSP and tender
# references payments are reconciled by, which makes them the one thing here
# worth keeping. Storage account > Security + networking > Access keys. Secret.
AZURE_STORAGE_CONNECTION_STRING=

# [orders] Table to store them in. Created on first use; no portal setup needed.
AZURE_ORDERS_TABLE=
