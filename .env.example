# Adyen Configuration
ADYEN_API_KEY=your_adyen_api_key_here
ADYEN_MERCHANT_ACCOUNT=your_merchant_account_here    # only used for /connectedTerminals check
ADYEN_TERMINAL_POIID=your_terminal_poi_id_here
ADYEN_SALE_ID=POSWebApp

# Currency
CURRENCY=EUR

# Server
PORT=3000

# --- Tap to Pay (Android Payments app) ---
# Default store used for boarding (transactions route over this store)
ADYEN_PAYMENTS_APP_STORE_ID=ST32CQ6223229X5PBQCM9BCWF
# Nexo shared key (Terminal API local encryption) — configure in Customer Area
ADYEN_NEXO_KEY_PASSPHRASE=your_nexo_passphrase_here
ADYEN_NEXO_KEY_IDENTIFIER=your_nexo_key_identifier_here
ADYEN_NEXO_KEY_VERSION=1
